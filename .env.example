# =============================================================================
# amei ayuko — backend environment
#
# Copy to the private application directory on the server as `_app/.env`
# (chmod 600). Never commit the real values: this file is the shape only.
# The frontend has its own, separate .env (frontend/.env.example) which may
# only ever contain public values.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production
SITE_URL=https://amei-ayuko.jp
# 32+ random bytes, hex or base64. Used to salt IP hashes and submission
# fingerprints. Changing it resets rate-limit state; it is not a signing key.
APP_SECRET=

# Set to true only if a reverse proxy in front of Apache sets X-Forwarded-For.
# On Lolipop this stays false — otherwise a visitor can spoof their own IP and
# walk around the contact-form rate limit.
TRUSTED_PROXY=false

SESSION_NAME=amei_session

# --- MySQL (Lolipop! control panel → データベース) ----------------------------
DB_HOST=mysqlXXX.phy.lolipop.lan
DB_PORT=3306
DB_NAME=LAAXXXXXX-amei
DB_USER=LAAXXXXXX
DB_PASSWORD=

# --- Mail ---------------------------------------------------------------------
# Where contact-form notifications and sync alerts are delivered. The admin
# screen can override this; this is the fallback.
ADMIN_EMAIL=

# Lolipop SMTP. PHP's mail() is not used.
SMTP_HOST=smtp.lolipop.jp
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=amei ayuko

# --- minne sync ---------------------------------------------------------------
# Shared secret between GitHub Actions and /api/sync/*. Generate with:
#   openssl rand -hex 32
# Store the same value in the repository secret MINNE_SYNC_API_KEY.
MINNE_SYNC_API_KEY=

# --- Cloudflare Turnstile -----------------------------------------------------
# The site key is public and also goes into frontend/.env as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. The secret key must never leave the server.
TURNSTILE_SECRET_KEY=
