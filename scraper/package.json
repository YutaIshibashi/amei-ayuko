{
  "name": "amei-ayuko-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "sync": "tsx src/index.ts",
    "sync:dry": "tsx src/index.ts --dry-run",
    "test": "node --import tsx --test --test-timeout=20000 test/*.test.ts",
    "smoke:upload": "tsx src/smoke-upload.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "sharp": "0.35.4",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
